{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RehmatLawnMowers",
  "version": "1.0.0",
  "identifier": "com.rehmatlawnmowers.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rehmat Lawn Mowers - Store Management & ERP",
        "width": 1366,
        "height": 768,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
